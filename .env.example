APP_NAME=DevPilot
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8001

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=devpilot
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
MYSQL_DATABASE=devpilot

REDIS_URL=redis://127.0.0.1:6379/0
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=devpilot_kb_v1
QDRANT_MEMORY_COLLECTION=devpilot_user_memory_v1
LONG_TERM_MEMORY_ENABLED=true
LONG_TERM_MEMORY_TOP_K=5
LONG_TERM_MEMORY_MIN_SCORE=0.42

# mock: 无本地模型也能跑基础链路；openai_compatible: 调用 vLLM
LLM_MODE=mock
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=EMPTY
LLM_MODEL=Qwen/Qwen3-4B-Instruct-2507

# V2 model roles. LOCAL_MODEL_* may be omitted to reuse LLM_* above.
LOCAL_MODEL_BASE_URL=http://127.0.0.1:8000/v1
LOCAL_MODEL_API_KEY=EMPTY
LOCAL_MODEL_NAME=devpilot-qwen4b
LOCAL_MODEL_PROVIDER=local_vllm
STRONG_MODEL_BASE_URL=
STRONG_MODEL_API_KEY=
STRONG_MODEL_NAME=
STRONG_MODEL_PROVIDER=modelscope
ALLOW_CLOUD_INTERNAL_DATA=false
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_ATTEMPTS=2

# Optional external GitHub MCP (Streamable HTTP, read-only allowlist).
# Never commit a real token. Map service names to owner/repository.
GITHUB_MCP_ENABLED=false
GITHUB_MCP_URL=
GITHUB_MCP_TOKEN=
GITHUB_MCP_TOOL_ALLOWLIST=["get_commit"]
GITHUB_MCP_REPOSITORIES={"order-service":"GoogleCloudPlatform/microservices-demo","payment-service":"GoogleCloudPlatform/microservices-demo","shipping-service":"GoogleCloudPlatform/microservices-demo"}
GITHUB_MCP_TIMEOUT_SECONDS=8
GITHUB_MCP_MAX_ATTEMPTS=2
GITHUB_MCP_MAX_RESULT_CHARS=12000

EMBED_MODEL=intfloat/multilingual-e5-small
EMBED_DEVICE=cpu
RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-v2-m3

RAG_DENSE_TOP_K=20
RAG_BM25_TOP_K=20
RAG_FUSED_TOP_K=10
RAG_FINAL_TOP_K=5
RAG_MIN_DENSE_SCORE=0.25

SESSION_TTL_SECONDS=86400
CACHE_TTL_SECONDS=600
RATE_LIMIT_PER_MINUTE=60
AUTH_SECRET_KEY=replace-with-at-least-32-random-characters
AUTH_TOKEN_MINUTES=480
AUTH_DEFAULT_TENANT=devpilot
AUTH_ADMIN_PASSWORD=
AUTH_ENGINEER_PASSWORD=
CONTEXT_MAX_INPUT_TOKENS=6000
CONTEXT_RECENT_TOKENS=2800
CONTEXT_SUMMARY_TOKENS=900
CONTEXT_MESSAGE_TOKENS=900
CONTEXT_HISTORY_MESSAGE_LIMIT=100
